/* =====================================================
   DAYDREAMS JAKARTA MASSAGE SPA PREMIUM V3 - LANDING PAGE
   Elegant Gold Beige Spa Theme for Blogger
   Bagi anda yang mengerti dan blogger profesional pastinya tidak akan menghapus link ini. 
   Membuat template ini tidak cukup 1 jam bro!
   
   Name       : DAYDREAMS JAKARTA MASSAGE SPA PREMIUM V3
   Date       : Tanggal Pembuatan Template Ini
   Updated by : Tuanbagues
   Devlopers  : GoSmart Teknologi Creative
   Blog       : https://gosmarttools.github.io/
   Store Blog : https://gosmartstore.blogspot.com/
   Lisensi    : https://github.com/gosmarttools/DAYDREAMS-MASSAGE-SPA/blob/993611118feecb3cc023b941592c5cc3a1b303d9/LICENSE

   ===================================================== */

/* ===== VARIABLES ===== */
:root {
  --gold: #c9a86c;
  --gold-dark: #b08d4f;
  --gold-light: #e8d5b0;
  --beige: #f8f1e3;
  --cream: #fdfaf5;
  --dark: #2c2416;
  --text: #4a4033;
  --white: #ffffff;
  --shadow: 0 10px 40px rgba(201,168,108,0.15);
  --radius: 16px;
  --transition: all 0.3s ease;
}

/* ===== RESET & BASE ===== */
*,*::before,*::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Poppins', sans-serif;
  font-size: 16px;
  line-height: 1.7;
  color: var(--text);
  background: var(--cream);
  overflow-x: hidden;
}
img { max-width: 100%; height: auto; display: block; }
a { text-decoration: none; color: inherit; transition: var(--transition); }
ul { list-style: none; }
h1,h2,h3,h4,h5,h6 {
  font-family: 'Marcellus', serif;
  font-weight: 400;
  color: var(--dark);
  line-height: 1.3;
}
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}
.section { padding: 80px 0; }
.section-title {
  text-align: center;
  margin-bottom: 50px;
}
.section-title span {
  display: block;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px;
}
.section-title h2 {
  font-size: clamp(28px, 5vw, 42px);
  margin-bottom: 15px;
}
.section-title p {
  max-width: 600px;
  margin: 0 auto;
  color: var(--text);
  opacity: 0.85;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px;
  background: var(--gold);
  color: var(--white);
  border-radius: 50px;
  font-weight: 500;
  font-size: 15px;
  border: 2px solid var(--gold);
  cursor: pointer;
  transition: var(--transition);
}
.btn:hover {
  background: var(--gold-dark);
  border-color: var(--gold-dark);
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}
.btn-outline {
  background: transparent;
  color: var(--gold);
}
.btn-outline:hover {
  background: var(--gold);
  color: var(--white);
}

/* ===== TOP BAR ===== */
.top-bar {
  background: var(--gold);
  color: var(--white);
  font-size: 13px;
  padding: 10px 0;
}
.top-bar .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}
.top-bar a { color: var(--white); opacity: 0.95; }
.top-bar a:hover { opacity: 1; }
.top-bar-right { display: flex; gap: 15px; align-items: center; }

/* ===== HEADER ===== */
.header {
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 2px 20px rgba(0,0,0,0.06);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 0;
}
.logo {
  display: flex;
  align-items: center;
  gap: 12px;
}
.logo img {
  height: 50px;
  width: auto;
}
.logo-text {
  font-family: 'Marcellus', serif;
  font-size: 22px;
  color: var(--dark);
  line-height: 1.2;
}
.logo-text span {
  display: block;
  font-family: 'Poppins', sans-serif;
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--gold);
  text-transform: uppercase;
}
.nav-menu {
  display: flex;
  gap: 28px;
  align-items: center;
}
.nav-menu a {
  font-size: 14px;
  font-weight: 500;
  color: var(--dark);
  position: relative;
}
.nav-menu a::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--gold);
  transition: width 0.3s;
}
.nav-menu a:hover::after,
.nav-menu a.active::after { width: 100%; }
.nav-menu a:hover { color: var(--gold); }

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 5px;
}
.hamburger span {
  display: block;
  width: 26px;
  height: 2px;
  background: var(--dark);
  transition: var(--transition);
}

/* ===== HERO ===== */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(44,36,22,0.65), rgba(201,168,108,0.4)),
              url('https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=1600&q=80') center/cover no-repeat;
  color: var(--white);
  overflow: hidden;
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: 650px;
  padding: 40px 0;
}
.hero-badge {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  padding: 8px 20px;
  border-radius: 50px;
  font-size: 13px;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 20px;
  border: 1px solid rgba(255,255,255,0.3);
}
.hero h1 {
  font-size: clamp(36px, 6vw, 58px);
  color: var(--white);
  margin-bottom: 20px;
  line-height: 1.15;
}
.hero p {
  font-size: 17px;
  opacity: 0.92;
  margin-bottom: 35px;
  max-width: 520px;
}
.hero-btns {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}
.hero-btns .btn {
  background: var(--gold);
  border-color: var(--gold);
}
.hero-btns .btn-outline {
  background: transparent;
  border-color: var(--white);
  color: var(--white);
}
.hero-btns .btn-outline:hover {
  background: var(--white);
  color: var(--dark);
}

/* ===== TRUST FEATURES ===== */
.trust-features {
  background: var(--white);
  padding: 40px 0;
  border-bottom: 1px solid rgba(201,168,108,0.15);
}
.trust-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
  text-align: center;
}
.trust-item {
  padding: 15px 10px;
}
.trust-item .icon {
  width: 50px;
  height: 50px;
  margin: 0 auto 12px;
  background: var(--beige);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  color: var(--gold);
}
.trust-item h4 {
  font-size: 14px;
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  margin-bottom: 4px;
}
.trust-item p {
  font-size: 12px;
  opacity: 0.7;
}

/* ===== ABOUT ===== */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.about-img {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.about-img img {
  width: 100%;
  height: 480px;
  object-fit: cover;
}
.about-img::after {
  content: '';
  position: absolute;
  inset: 0;
  border: 3px solid var(--gold);
  border-radius: var(--radius);
  pointer-events: none;
  margin: 12px;
}
.about-content h2 {
  font-size: 36px;
  margin-bottom: 20px;
}
.about-content p {
  margin-bottom: 18px;
  opacity: 0.9;
}
.about-stats {
  display: flex;
  gap: 30px;
  margin-top: 30px;
}
.stat-item h3 {
  font-size: 32px;
  color: var(--gold);
  margin-bottom: 4px;
}
.stat-item span {
  font-size: 13px;
  opacity: 0.7;
}

/* ===== TREATMENTS ===== */
.treatments { background: var(--beige); }
.treatment-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}
.treatment-card {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 5px 25px rgba(0,0,0,0.06);
  transition: var(--transition);
}
.treatment-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow);
}
.treatment-card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}
.treatment-card .body {
  padding: 22px;
}
.treatment-card h3 {
  font-size: 20px;
  margin-bottom: 10px;
}
.treatment-card p {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 15px;
}
.treatment-card .price {
  font-weight: 600;
  color: var(--gold);
  font-size: 16px;
}

/* ===== PACKAGES ===== */
.packages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}
.package-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 40px 30px;
  text-align: center;
  border: 2px solid transparent;
  transition: var(--transition);
  position: relative;
}
.package-card.featured {
  border-color: var(--gold);
  transform: scale(1.05);
  box-shadow: var(--shadow);
}
.package-card.featured .badge {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gold);
  color: white;
  padding: 6px 20px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1px;
}
.package-card h3 {
  font-size: 24px;
  margin-bottom: 10px;
}
.package-card .price {
  font-size: 42px;
  color: var(--gold);
  font-family: 'Marcellus', serif;
  margin: 20px 0;
}
.package-card .price span {
  font-size: 16px;
  font-family: 'Poppins', sans-serif;
  color: var(--text);
}
.package-card ul {
  text-align: left;
  margin: 25px 0;
}
.package-card ul li {
  padding: 8px 0;
  padding-left: 28px;
  position: relative;
  font-size: 14px;
}
.package-card ul li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-weight: 700;
}

/* ===== PRICING TABLE ===== */
.pricing-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 5px 25px rgba(0,0,0,0.06);
}
.pricing-table th,
.pricing-table td {
  padding: 18px 20px;
  text-align: center;
  border-bottom: 1px solid rgba(201,168,108,0.15);
}
.pricing-table th {
  background: var(--gold);
  color: white;
  font-weight: 500;
  font-size: 15px;
}
.pricing-table tr:last-child td { border-bottom: none; }
.pricing-table td:first-child {
  text-align: left;
  font-weight: 500;
}
.pricing-table .price-cell {
  color: var(--gold);
  font-weight: 600;
}

/* ===== THERAPISTS ===== */
.therapists { background: var(--beige); }
.therapist-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}
.therapist-card {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  text-align: center;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  transition: var(--transition);
}
.therapist-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow);
}
.therapist-card img {
  width: 100%;
  height: 280px;
  object-fit: cover;
}
.therapist-card .info {
  padding: 20px 15px;
}
.therapist-card h4 {
  font-size: 18px;
  margin-bottom: 5px;
}
.therapist-card span {
  font-size: 13px;
  color: var(--gold);
  font-weight: 500;
}

/* ===== HOW TO BOOK ===== */
.steps-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}
.step-card {
  text-align: center;
  padding: 30px 20px;
  background: var(--white);
  border-radius: var(--radius);
  position: relative;
}
.step-num {
  width: 50px;
  height: 50px;
  background: var(--gold);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 18px;
  margin: 0 auto 20px;
}
.step-card h4 {
  font-size: 18px;
  margin-bottom: 10px;
}
.step-card p {
  font-size: 14px;
  opacity: 0.8;
}

/* ===== TESTIMONIALS ===== */
.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}
.testimonial-card {
  background: var(--white);
  padding: 30px;
  border-radius: var(--radius);
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}
.testimonial-card .stars {
  color: var(--gold);
  margin-bottom: 15px;
  font-size: 18px;
}
.testimonial-card p {
  font-style: italic;
  margin-bottom: 20px;
  opacity: 0.9;
}
.testimonial-card .author {
  display: flex;
  align-items: center;
  gap: 12px;
}
.testimonial-card .author img {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  object-fit: cover;
}
.testimonial-card .author h5 {
  font-size: 15px;
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
}

/* ===== FAQ ===== */
.faq-list {
  max-width: 800px;
  margin: 0 auto;
}
.faq-item {
  background: var(--white);
  border-radius: 12px;
  margin-bottom: 12px;
  overflow: hidden;
  box-shadow: 0 3px 15px rgba(0,0,0,0.04);
}
.faq-question {
  padding: 20px 25px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: var(--transition);
}
.faq-question:hover { color: var(--gold); }
.faq-answer {
  padding: 0 25px 20px;
  font-size: 15px;
  opacity: 0.85;
  display: none;
}
.faq-item.active .faq-answer { display: block; }
.faq-item.active .faq-question { color: var(--gold); }

/* ===== CTA / BOOK ===== */
.cta-section {
  background: linear-gradient(135deg, var(--dark), #3d3220);
  color: white;
  text-align: center;
  padding: 80px 0;
}
.cta-section h2 {
  color: white;
  font-size: 36px;
  margin-bottom: 15px;
}
.cta-section p {
  opacity: 0.9;
  max-width: 500px;
  margin: 0 auto 30px;
}
.cta-section .btn {
  background: var(--gold);
  border-color: var(--gold);
  font-size: 16px;
  padding: 16px 40px;
}

/* ===== FOOTER ===== */
.footer {
  background: var(--dark);
  color: rgba(255,255,255,0.8);
  padding: 60px 0 30px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 40px;
  margin-bottom: 40px;
}
.footer h4 {
  color: white;
  font-size: 18px;
  margin-bottom: 20px;
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
}
.footer p, .footer a {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 10px;
  display: block;
}
.footer a:hover { opacity: 1; color: var(--gold); }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 25px;
  text-align: center;
  font-size: 13px;
  opacity: 0.7;
}

/* ===== FLOATING BUTTONS ===== */
.float-btns {
  position: fixed;
  bottom: 25px;
  right: 25px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.float-btn {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 26px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.25);
  transition: var(--transition);
}
.float-btn:hover { transform: scale(1.1); }
.float-wa { background: #25d366; }
.float-call { background: #0084ff; }

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .trust-grid { grid-template-columns: repeat(3, 1fr); }
